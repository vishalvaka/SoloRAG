# ──────────────────────────────────────────────────────────
# SoloRAG Environment Variables
# Copy to .env and adjust for your environment.
# All values below are LOCAL DEV defaults.
# ──────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO

# ── Database (PostgreSQL / Aurora via RDS Proxy) ──────────
DATABASE_URL=postgresql+asyncpg://solorag:solorag@localhost:5432/solorag

# ── Auth ──────────────────────────────────────────────────
SESSION_SECRET=change-me-in-production
SESSION_TTL_HOURS=24

# ── LLM Backend ──────────────────────────────────────────
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama:latest
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# BEDROCK_REGION=us-east-1

# ── Vector Store ─────────────────────────────────────────
VECTOR_BACKEND=faiss
FAISS_FORCE_CPU=1
# OPENSEARCH_URL=https://your-domain.us-east-1.es.amazonaws.com
# OPENSEARCH_INDEX=solorag-vectors

# ── Session Token Store ──────────────────────────────────
SESSION_BACKEND=memory
# SESSION_BACKEND=dynamodb
# DYNAMODB_TABLE=solorag-sessions
# DYNAMODB_REGION=us-east-1
# DYNAMODB_ENDPOINT=http://localhost:8100

# ── Cache ────────────────────────────────────────────────
CACHE_BACKEND=none
# CACHE_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL_SECONDS=3600

# ── Proxy (corporate compliance) ─────────────────────────
# HTTP_PROXY=http://proxy.corp.com:8080
# HTTPS_PROXY=http://proxy.corp.com:8080
# NO_PROXY=localhost,127.0.0.1,.internal
# CUSTOM_CA_BUNDLE=/etc/ssl/certs/corporate-ca.pem

# ── Streamlit Frontend ───────────────────────────────────
BACKEND_URL=http://localhost:8000
